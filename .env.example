# ---------------------------------------------------------------------------
# Corvane website environment variables
# Copy to `.env.local` (development) or `.env.production` / your host's secret
# store (production). NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph,
# sitemap and structured data. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Search engine indexing. Anything other than "true" serves a robots.txt that
# blocks all crawlers and adds noindex. Set to true ONLY on the live domain.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Lead delivery ----------------------------------------------------------
# At least ONE channel must be configured or the form returns a clear
# "not sent" error (it never pretends to succeed).

# Resend (https://resend.com). The FROM domain must be verified in Resend.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=          # comma-separated recipients, e.g. sales@your-domain.com
INQUIRY_FROM_EMAIL=        # e.g. "Corvane Website <website@your-domain.com>"

# JSON Lines backup log of every inquiry. Use an ABSOLUTE path in production
# (the standalone server changes its working directory). Protect this file —
# it contains personal data — and include it in your retention policy.
INQUIRY_LOG_FILE=

# Submissions allowed per client IP per 10 minutes (default 5).
INQUIRY_RATE_LIMIT=5

# --- Sanity CMS (optional) --------------------------------------------------
# Leave empty to use the typed local content in src/content.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Only needed for a private dataset. Read-only token, server-side only.
SANITY_READ_TOKEN=
